# =====================================================================
# Nexfolio - Template .env untuk PROYEK DEMO (Laravel) di Hostinger
# GENERIK — contoh saja. Salin ke `.env` DI PROYEK DEMO ANDA, lalu isi
# sesuai proyek tersebut. JANGAN pakai nilai dari proyek lain.
# =====================================================================

APP_NAME="Demo Proyek"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo-namaproyek.domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=user_demo1
DB_USERNAME=user_demo1
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Konfigurasi lain sesuai kebutuhan proyek demo (mail, integrasi, dsb.)
# MAIL_MAILER=log
# dsb.
